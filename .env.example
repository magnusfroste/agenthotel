# Optional settings for docker compose. Copy to .env next to docker-compose.yml.
# Nothing here is required: the admin account and the panel's domain are set
# up in the web UI on first visit (install.sh prints the setup link).

# Where Caddy publishes HTTP and HTTPS. Behind a tunnel, bind them to
# localhost so the server's IP cannot be used to skip the tunnel:
#   AGENTHOTEL_HTTP=127.0.0.1:80
#   AGENTHOTEL_HTTPS=127.0.0.1:443
# AGENTHOTEL_HTTP=80
# AGENTHOTEL_HTTPS=443
