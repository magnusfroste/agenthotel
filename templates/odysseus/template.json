{
  "id": "odysseus",
  "name": "Odysseus",
  "description": "Self-hosted AI workspace — chat, agents, deep research, memory",
  "version": "1.0.0",
  "author": "AgentHotel",
  "defaultImage": "odysseus:latest",
  "defaultPort": 7000,
  "configFields": [
    {
      "key": "ODYSSEUS_ADMIN_PASSWORD",
      "label": "Admin Password",
      "type": "password",
      "required": true,
      "description": "Admin-lösenord för Odysseus"
    },
    {
      "key": "AUTH_ENABLED",
      "label": "Auth Enabled",
      "type": "select",
      "options": ["true", "false"],
      "default": "true",
      "description": "Aktivera autentisering"
    },
    {
      "key": "LLM_HOST",
      "label": "LLM Host",
      "type": "text",
      "required": false,
      "description": "Custom LLM endpoint (valfritt)"
    }
  ],
  "providers": ["openai"],
  "volumes": ["/data"],
  "healthCheck": {
    "path": "/",
    "port": 7000,
    "interval": 30,
    "timeout": 5,
    "retries": 5
  },
  "resources": {
    "memory": "1g",
    "cpu": "1"
  },
  "features": [
    "chat",
    "agents",
    "research",
    "memory"
  ]
}
