{
  "admin": {
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":80", ":443"],
          "routes": [
            {
              "match": [{ "host": ["{$PANEL_DOMAIN}"] }],
              "handle": [{
                "handler": "subroute",
                "routes": [
                  {
                    "match": [{ "path": ["/api/*"] }],
                    "handle": [{
                      "handler": "reverse_proxy",
                      "upstreams": [{ "dial": "backend:8080" }]
                    }]
                  },
                  {
                    "handle": [{
                      "handler": "reverse_proxy",
                      "upstreams": [{ "dial": "frontend:80" }]
                    }]
                  }
                ]
              }]
            }
          ],
          "automatic_https": {}
        }
      }
    }
  }
}
