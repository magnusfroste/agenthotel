{
  "admin": {
    "disabled": false,
    "listen": "0.0.0.0:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "panel": {
          "listen": [":80", ":443"],
          "routes": [
            {
              "match": [{ "host": ["{$PANEL_DOMAIN}"] }],
              "handle": [{
                "handler": "reverse_proxy",
                "upstreams": [{ "dial": "backend:8080" }]
              }]
            }
          ],
          "automatic_https": {}
        },
        "agents": {
          "@id": "agentpanel-routes",
          "listen": [":443"],
          "routes": [],
          "automatic_https": {}
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          { "subjects": ["{$PANEL_DOMAIN}"], "issuers": [{ "module": "letsencrypt" }] },
          { "issuers": [{ "module": "letsencrypt" }] }
        ]
      }
    }
  }
}
